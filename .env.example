# ChainCloud-AI environment example
#
# Copy this file to .env before running locally:
#
#   cp .env.example .env
#
# IMPORTANT:
# - Do NOT commit real passwords, API keys, tokens, or private credentials.
# - Internal host/port examples below are intended for the private company repository only.
# - If this repository may become public, replace internal IPs with <HOST> placeholders.

# ── LLM / OpenAI-compatible API ─────────────────────────────
OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
OPENAI_TIMEOUT_SEC=60
OPENAI_MAX_RETRIES=2
MAX_TOOL_RETRIES=2
MAX_STEP_RETRIES=2
MAX_TOTAL_TOOL_CALLS=12

# Optional API token for /chat.
# Leave empty or commented for local testing if auth is not required.
# CHAT_API_TOKEN=<CHAT_API_TOKEN>

# ── PostgreSQL: auth / long-term memory ─────────────────────
# Company PostgreSQL target:
#   database: test
#   schema: chaincloud_ai
#
# These two URLs are used by the user login system and long-term memory system.
# They should point to the company PostgreSQL schema where ChainCloud-AI can create tables.
AUTH_DATABASE_URL=postgresql://defi_user_1:<PASSWORD>@10.8.6.153:5432/test?options=-c%20search_path%3Dchaincloud_ai
MEMORY_DATABASE_URL=postgresql://defi_user_1:<PASSWORD>@10.8.6.153:5432/test?options=-c%20search_path%3Dchaincloud_ai

# Optional LangGraph thread checkpoint persistence.
# Keep this local by default unless you explicitly want thread checkpoints in company PostgreSQL.
# DATABASE_URL=postgresql://chaincloud:<PASSWORD>@localhost:15432/chaincloud_memory_dev

# ── PostgreSQL readonly tool ─────────────────────────────────
# Enables:
# - postgres_select
# - postgres_list_tables
# - postgres_table_schema
# - search_knowledge
#
# For user-level memory reading, prefer querying a non-sensitive view such as:
#   chaincloud_ai.agent_memory_public
READONLY_DATABASE_URL=postgresql://defi_user_1:<PASSWORD>@10.8.6.153:5432/test?options=-c%20search_path%3Dchaincloud_ai

# ── ClickHouse readonly tool ─────────────────────────────────
# Enables:
# - clickhouse_select
READONLY_CLICKHOUSE_HOST=10.8.6.153
READONLY_CLICKHOUSE_PORT=5886
READONLY_CLICKHOUSE_USER=test
READONLY_CLICKHOUSE_PASSWORD=<CLICKHOUSE_PASSWORD>
READONLY_CLICKHOUSE_DATABASE=trx
READONLY_CLICKHOUSE_SECURE=0

# Multi-datasource ClickHouse registry.
# Host/port/default_database/description are stored in config/clickhouse_datasources.json.
# Credentials stay in environment variables and should not be committed.
CLICKHOUSE_DATASOURCES_CONFIG_PATH=config/clickhouse_datasources.json
CLICKHOUSE_TRX_5886_USER=test
CLICKHOUSE_TRX_5886_PASSWORD=<CLICKHOUSE_TRX_5886_PASSWORD>
CLICKHOUSE_ANALYTICS_5887_USER=test
CLICKHOUSE_ANALYTICS_5887_PASSWORD=<CLICKHOUSE_ANALYTICS_5887_PASSWORD>

# ── Ethereum JSON-RPC tool ───────────────────────────────────
# Enables:
# - ethereum_jsonrpc
#
# Company Ethereum mainnet RPC examples:
# - Erigon: http://10.8.6.153:2700
# - Geth:   http://10.8.6.153:2705
ETHEREUM_JSONRPC_URL=http://10.8.6.153:2700

# ── TRON RPC tool ────────────────────────────────────────────
# Enables:
# - tron_node_request
#
# full node:
#   target=full
#   common path=/wallet/getnowblock
#
# solidity node:
#   target=solidity
#   common path=/walletsolidity/getnowblock
TRON_FULL_RPC=http://10.8.6.153:2633
TRON_SOLIDITY_RPC=http://10.8.6.153:2634

# Optional TronGrid settings. Usually not needed when using company internal nodes.
# TRON_API_KEY=<TRON_API_KEY>
# TRON_GRID_API_KEY=<TRON_GRID_API_KEY>
# TRON_RPC_URL=https://api.trongrid.io

# ── Contract decode tool ─────────────────────────────────────
# Enables:
# - contract_decode_tx_input
#
# Recommended local layout:
#   ~/Desktop/Chaincloud-MY
#   ~/Desktop/AI-ContractParser
#
# Do not commit AI-ContractParser into this repository unless the team decides to vendor it.
CONTRACT_DECODE_SCRIPT_PATH=/absolute/path/to/AI-ContractParser/scripts/decode/decode-tx-input.js
CONTRACT_PARSER_CWD=/absolute/path/to/AI-ContractParser
CONTRACT_DECODE_TIMEOUT_SEC=120
AGENT_CONTRACT_DECODE_PATH=config/agent_contract_decode.md

# ── Knowledge base / pgvector ────────────────────────────────
# search_knowledge only returns useful results when KB_ENABLED=true and pgvector data exists.
KB_ENABLED=false

# ── Local output paths ───────────────────────────────────────
# These outputs should not be committed.
CHART_OUTPUT_DIR=charts


# ── Web Search tool ──────────────────────────────────────────
# Enables:
# - web_search
#
# Note:
# DeepSeek API / OpenAI-compatible API does not automatically provide the
# web search feature from the provider web/app product. Public web search
# must be implemented as an explicit tool in this service.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=<TAVILY_API_KEY>
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SEC=15
