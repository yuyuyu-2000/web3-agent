# ChainCloud-AI local Docker PostgreSQL example
# Recommended runtime versions:
#   Python: 3.11 or 3.12
#   Node.js: 22 LTS recommended, minimum 20.19+
# Usage:
#   cp .env.docker.example .env
#   Fill OPENAI_API_KEY and other required model settings.
#   Run: docker compose up -d postgres
#   Run: ./scripts/setup_local_postgres.sh

# ===== LLM provider =====
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
OPENAI_TIMEOUT_SEC=60
OPENAI_MAX_RETRIES=2
MAX_TOOL_RETRIES=2
MAX_STEP_RETRIES=2
MAX_TOTAL_TOOL_CALLS=12

# Optional API token for local backend auth.
CHAT_API_TOKEN=

# ===== Local Docker PostgreSQL port =====
# Default host port is 15432 to avoid conflicts with local PostgreSQL on 5432.
# If you want to use the standard local port, set POSTGRES_HOST_PORT=5432
POSTGRES_HOST_PORT=15432

# ===== PostgreSQL checkpoint persistence for normal chat threads =====
# DATABASE_URL is optional and enables PostgreSQL checkpoint persistence for normal chat threads.
# Keep it disabled for the first local run, especially on Windows.
# Enable it only after confirming checkpoint compatibility in your environment.
# DATABASE_URL=postgresql://chaincloud:chaincloud_dev@localhost:15432/chaincloud_memory_dev

# ===== PostgreSQL long-term Agent Memory =====
MEMORY_STORE_BACKEND=postgres
MEMORY_DATABASE_URL=postgresql://chaincloud:chaincloud_dev@localhost:15432/chaincloud_memory_dev
MEMORY_POSTGRES_TABLE=agent_memories
MEMORY_POSTGRES_AUTO_CREATE=0

# ===== Read-only database tools =====
READONLY_DATABASE_URL=


# ===== User login MVP =====
# AUTH_DATABASE_URL defaults to MEMORY_DATABASE_URL when omitted.
# Use the same local Docker PostgreSQL database for first local testing.
AUTH_DATABASE_URL=postgresql://chaincloud:chaincloud_dev@localhost:15432/chaincloud_memory_dev
AUTH_USERS_TABLE=agent_users
AUTH_POSTGRES_AUTO_CREATE=0
AUTH_TOKEN_SECRET=change-me-in-local-dev
AUTH_TOKEN_EXPIRE_MINUTES=1440
